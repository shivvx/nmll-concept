# GEMINI_API_KEY: Required for Gemini AI API calls & NMLL Copilot features.
# Copy this file to .env.local and insert your API key.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# APP_URL: The public or local URL where this application is hosted.
# Default for local development: http://localhost:3000
APP_URL="http://localhost:3000"
PORT=3000
